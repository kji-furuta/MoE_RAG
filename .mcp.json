{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "/home/ict/MoE_RAG"
      ],
      "env": {}
    },
  "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "..."
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "cipher": {
      "type": "stdio",
      "command": "cipher",
      "args": ["--mode", "mcp"],
      "env": {
        "CIPHER_WORKSPACE": "${workspaceFolder}/.cipher",
        "CIPHER_EMBEDDER": "local",
        "CIPHER_PERSISTENT_MEMORY": "true",
        "CIPHER_DB_PATH": "${workspaceFolder}/data/cipher-sessions.db",
        "CIPHER_ENABLE_LONG_TERM_MEMORY": "true"
      }
    }   
  }
}
